# Plantilla de variables del despliegue. Copiar a .env y completar; .env nunca se versiona.

# Clave que deben presentar n8n y la interfaz web al llamar a la API del detector.
API_KEY=
# Token de solo lectura de Hugging Face (el repositorio de modelos es privado; ver models/README.md).
HF_TOKEN=
MODEL_REPO=dennysSalazar/g17-phishing-hibrido
MODEL_REVISION=v2
# Dominios de la organización separados por coma (opcional).
DOMINIOS_PROPIOS=
# Umbral operativo de la ruta inglesa (decisión D27). Vacío = umbral de validación 0,039 (decisión D9).
UMBRAL_EN=0.8586

# Debe coincidir con IRIS_ADM_API_KEY del archivo .env de iris-web.
IRIS_API_KEY=
IRIS_CUSTOMER_ID=1

# Política de contraseñas de Wazuh: 8 a 64 caracteres con mayúscula, minúscula, número y uno de . * + ? -
WAZUH_API_USER=wazuh-wui
WAZUH_API_PASSWORD=
